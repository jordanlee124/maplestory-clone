{
  "name": "cindervale-online",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:pglite": "pnpm --filter @cindervale/database db:pglite",
    "db:generate": "pnpm --filter @cindervale/database db:generate",
    "db:migrate": "pnpm --filter @cindervale/database db:migrate"
  },
  "devDependencies": {
    "@cindervale/config": "workspace:*",
    "@cindervale/database": "workspace:*",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "turbo": "^2.11.9",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
